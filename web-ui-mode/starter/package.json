  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dompurify": "3.4.16",
    "esbuild": "0.28.2",
    "marked": "18.0.14",
    "playwright-core": "1.56.1",
    "preact": "11.0.0",
    "typescript": "5.7.3"
  }
}
