{
  "name": "@a-t-h-i/bot-lobby",
  "version": "0.6.20",
  "description": "Structured multi-agent software engineering orchestrator for Pi",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "multi-agent",
    "subagents",
    "orchestrator",
    "code-review",
    "web-search"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-t-h-i/bot-lobby.git"
  },
  "homepage": "https://github.com/a-t-h-i/bot-lobby#readme",
  "bugs": {
    "url": "https://github.com/a-t-h-i/bot-lobby/issues"
  },
  "files": [
    "src",
    "prompts",
    "webui/dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/a-t-h-i/bot-lobby/main/docs/gallery.png"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p webui --noEmit",
    "web:dev": "node src/webui/dev/serve.ts",
    "web:build": "vite build --config webui/vite.config.ts && node webui/scripts/build-info.mjs",
    "web:typecheck": "tsc -p webui --noEmit",
    "web:check": "playwright test",
    "test": "node --test --test-reporter=dot test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@earendil-works/pi-ai": "0.87.0",
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@earendil-works/pi-tui": "0.87.0",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.62.0",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.49.0",
    "motion": "14.0.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "socket.io": "4.8.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typebox": "1.3.27",
    "typescript": "^5.7.0",
    "vite": "8.3.2"
  },
  "dependencies": {
    "https-proxy-agent": "^9.1.0",
    "socket.io-client": "4.8.4"
  }
}
